# Application
APP_NAME=axiom-forge-ryan-vo
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/audit.db

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-secret-key-min-32-characters-long
CSRF_SECRET=your-csrf-secret-min-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak (optional - enable for production)
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/axiom-forge
OIDC_CLIENT_ID=axiom-forge-frontend
OIDC_CLIENT_SECRET=axiom-forge-frontend-secret
OIDC_REDIRECT_URI=http://127.0.0.1:5173/callback
OIDC_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173

# Demo Mode (localhost only - REFUSED in production)
DEMO_MODE=true

# LLM Providers (optional)
LLM_DEFAULT_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-model

# CORS
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Audit
DEFAULT_SUITE=essential
AUDIT_TIMEOUT_SECONDS=120

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api/v1